# Copy to `.env` and fill in. Only EXPO_PUBLIC_* vars reach the app bundle.
#
# Local Supabase (`npm run db:start` at the repo root) prints these values.
# NOTE: on a physical device, localhost is the phone, not your Mac — use your
# machine's LAN IP instead, e.g. http://192.168.1.20:54321
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321

# The local anon key is a fixed development key printed by `supabase start`.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
