{
  "expo": {
    "name": "KiasuJobs",
    "slug": "kiasujobs",
    "version": "0.1.0",
    "scheme": "kiasujobs",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kiasujobs.app"
    },
    "android": {
      "package": "com.kiasujobs.app",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "KiasuJobs uses your photos so you can upload a company logo."
        }
      ]
    ]
  }
}
