{
  "name": "@kiasujobs/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "comment": "Only `expo` is pinned. Every Expo/React Native package is left open so `npm install` can never fail on a version that does not exist; `npm run setup` (expo install --fix) then pins them all to the exact versions Expo ships for SDK 57. Run setup once after installing.",
  "scripts": {
    "setup": "expo install --fix",
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "fix:deps": "expo install --fix",
    "doctor": "expo-doctor",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kiasujobs/shared": "*",
    "@react-native-async-storage/async-storage": "*",
    "@supabase/supabase-js": "^2.58.0",
    "expo": "~57.0.0",
    "expo-auth-session": "*",
    "expo-constants": "*",
    "expo-document-picker": "*",
    "expo-image": "*",
    "expo-image-picker": "*",
    "expo-linking": "*",
    "expo-router": "*",
    "expo-status-bar": "*",
    "expo-web-browser": "*",
    "react": "*",
    "react-dom": "*",
    "react-native": "*",
    "react-native-gesture-handler": "*",
    "react-native-reanimated": "*",
    "react-native-safe-area-context": "*",
    "react-native-screens": "*",
    "react-native-worklets": "*",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "*",
    "typescript": "^5.9.2"
  }
}
